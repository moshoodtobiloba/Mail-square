rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Globally deny access to all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check collection (publicly readable for simple connectivity test)
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User-isolated data
    // match /users/{userId} matches the user document itself
    // match /users/{userId}/{allPaths=**} matches all subcollections at any depth
    match /users/{userId} {
      allow get, list, create, update, delete: if isOwner(userId);
      
      match /{allPaths=**} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // Message reactions (for collaborative features)
    match /message_reactions/{reactionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }
  }
}
