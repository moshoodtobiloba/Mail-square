rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic root denial
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check
    match /test/connection {
      allow read: if true;
    }

    // Comprehensive User rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Recursive match for any subcollections (leads, campaign_steps, etc.)
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
