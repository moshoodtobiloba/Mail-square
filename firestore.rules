rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health
    match /test/connection {
      allow read: if true;
    }

    // User Data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Message Reactions
    match /message_reactions/{reactionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }
  }
}
